{
  "name": "@ohmykreee/dsh-llm-retry-boost",
  "version": "1.0.0",
  "description": "Unlimited capped-backoff retries for transient model-request failures, with configuration-class failures kept on the shipped retry policy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmykreee/dsh-llm-retry-boost.git"
  },
  "homepage": "https://github.com/ohmykreee/dsh-llm-retry-boost#readme",
  "bugs": {
    "url": "https://github.com/ohmykreee/dsh-llm-retry-boost/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "retry",
    "backoff",
    "llm"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./policy": "./lib/policy.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/policy.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
